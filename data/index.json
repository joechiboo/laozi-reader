  "chapters": [
    {
      "chapter": 1,
      "part": "道經",
      "gist": "道說不盡、名叫不全；從無與有兩頭看同一件事",
      "status": "draft",
      "segments": 7,
      "notes": 10
    },
    {
      "chapter": 4,
      "part": "道經",
      "gist": "道是虛的，所以用不完；在天帝之先",
      "status": "draft",
      "segments": 5,
      "notes": 5
    },
    {
      "chapter": 6,
      "part": "道經",
      "gist": "谷神玄牝：生而不竭的那道門，是天地的根",
      "status": "draft",
      "segments": 3,
      "notes": 5
    },
    {
      "chapter": 8,
      "part": "道經",
      "gist": "上善若水：利萬物、不爭、居下，所以最接近道",
      "status": "draft",
      "segments": 4,
      "notes": 8
    },
    {
      "chapter": 39,
      "part": "德經",
      "gist": "得一者全，失一者裂；貴以賤為本，高以下為基",
      "status": "draft",
      "segments": 6,
      "notes": 6
    },
    {
      "chapter": 40,
      "part": "德經",
      "gist": "反者道之動，弱者道之用；有生於無",
      "status": "draft",
      "segments": 2,
      "notes": 4
    },
    {
      "chapter": 42,
      "part": "德經",
      "gist": "道生萬物的次第；陰陽沖和，損益相反而相成",
      "status": "draft",
      "segments": 6,
      "notes": 11
    },
    {
      "chapter": 48,
      "part": "德經",
      "gist": "為學日益，為道日損；損到無為，取天下常以無事",
      "status": "draft",
      "segments": 4,
      "notes": 6
    },
    {
      "chapter": 57,
      "part": "德經",
      "gist": "以無事取天下；我無為而民自化",
      "status": "draft",
      "segments": 4,
      "notes": 6
    },
    {
      "chapter": 60,
      "part": "德經",
      "gist": "治大國若烹小鮮：不擾動，則鬼神與聖人都不傷人",
      "status": "draft",
      "segments": 5,
      "notes": 6
    },
    {
      "chapter": 66,
      "part": "德經",
      "gist": "江海善下所以為百谷王；不爭，故天下莫能與之爭",
      "status": "draft",
      "segments": 5,
      "notes": 5
    },
    {
      "chapter": 76,
      "part": "德經",
      "gist": "柔弱者生之徒，堅強者死之徒；強大處下，柔弱處上",
      "status": "draft",
      "segments": 5,
      "notes": 5
    },
    {
      "chapter": 78,
      "part": "德經",
      "gist": "天下莫柔弱於水，而攻堅強者莫之能勝；正言若反",
      "status": "draft",
      "segments": 4,
      "notes": 5
    },
    {
      "chapter": 81,
      "part": "德經",
      "gist": "全書收束：信美、善辯、知博三組相反，終於利而不害、為而不爭",
      "status": "draft",
      "segments": 5,
      "notes": 7
    }
