{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://joechiboo.github.io/laozi-reader/data/schema.json",
  "title": "道德經單章資料 (laozi-reader chapter)",
  "description": "一章一檔，檔名 data/chapters/NNN.json（三位數，補零）。底本：王弼本（公版）。白話與註解一律自撰，不得抄錄任何現行譯註本文字。",
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter", "part", "text", "segments", "plain", "notes", "keywords", "meta"],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 81,
      "description": "章次（王弼本分章）"
    },
    "part": {
      "enum": ["道經", "德經"],
      "description": "道經 1–37、德經 38–81"
    },
    "gist": {
      "type": "string",
      "maxLength": 40,
      "description": "一句話章旨，給左側索引與搜尋結果當摘要用。可省略。"
    },
    "text": {
      "type": "string",
      "description": "全章原文，王弼本，加現代標點。等同 segments 各句 text 串接後的結果（build 會檢查一致性）。"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "description": "斷句。原文與白話的對位單位——並列呈現時左右以 id 對齊。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "plain"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,1}[.][1-9][0-9]{0,1}$",
            "description": "章.句序，如 \"1.3\"。跨章連結的錨點（#1.3），一經發布不可重編。"
          },
          "text": { "type": "string", "description": "該句原文" },
          "plain": { "type": "string", "description": "該句白話。自撰，口語即可，不求文采。" },
          "alt": {
            "type": "string",
            "description": "此句另有重要異讀時，寫另一種讀法的白話（如第 1 章「無名／無，名」兩讀）。詳細論證放 notes。"
          }
        }
      }
    },
    "plain": {
      "type": "string",
      "description": "全章白話通讀。不是 segments 的機械串接，而是補上語氣與轉折、可獨立讀完的一段。"
    },
    "notes": {
      "type": "array",
      "description": "註解。一筆一事，短而可查；訓詁與異文要標出處。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ref", "type", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^n[0-9]+$",
            "description": "章內唯一，如 \"n1\"。"
          },
          "ref": {
            "type": "string",
            "description": "所註的 segment id（如 \"1.3\"）；註全章寫 \"*\"。"
          },
          "term": {
            "type": "string",
            "description": "所註的字詞。整句串講可省略。"
          },
          "type": {
            "enum": ["訓詁", "異文", "異讀", "義理", "互見"],
            "description": "訓詁=字義；異文=他本作某字；異讀=同一文字的不同斷句/理解；義理=思想串講；互見=與他章對讀"
          },
          "text": { "type": "string", "description": "註解本文。自撰。" },
          "source": {
            "type": "string",
            "description": "依據，如「王弼注」「河上公注」「帛書本」「說文」。古注與出土本為公版，須註明；現行譯註本一律不引。"
          },
          "see": {
            "type": "array",
            "items": { "type": "string" },
            "description": "互見的 segment id，如 [\"40.2\", \"42.1\"]。type=互見 時必填。"
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "description": "本章出現、且值得跨章追蹤的關鍵詞。build_index.py 依此反向建全書索引。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "refs"],
        "properties": {
          "term": {
            "type": "string",
            "description": "關鍵詞。用詞須與 data/keywords.md 的受控詞表一致（同一概念只用一種寫法）。"
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "該詞在本章出現的 segment id，跳轉落點。"
          },
          "sense": {
            "type": "string",
            "description": "同字異義時標義項（如「道」在 1.1 兼指道體與言說），供索引分流。"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["draft", "reviewed"],
          "description": "draft=Claude 起草或補註、尚未校稿；reviewed=已口述改寫並校過，可上站。"
        },
        "base": {
          "type": "string",
          "default": "王弼本",
          "description": "原文底本"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "最後修訂日"
        },
        "todo": {
          "type": "array",
          "items": { "type": "string" },
          "description": "待辦／待查，校稿時清空"
        }
      }
    }
  }
}
